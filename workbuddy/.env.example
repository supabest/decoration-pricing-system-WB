# ============================================================================
# 变量名模板 · 本文件不含任何真实值，也绝不要把它改成含值的文件后提交
#
# 【主路径】WorkBuddy 项目公共授权：下列 WB_SUPABASE_* 由平台云端注入，
#           管理员在项目配置里录入一次，成员与 AI 都不接触明文。
#           不要手填、不要写进 .env、不要进仓库、不要贴进对话。
# ============================================================================

# supabase = 云端价表（正式唯一路径）；snapshot = 本地加密快照（仅调试兜底）
# WB_PRICING_SOURCE=supabase

# REST 根地址：直连 https://<project>.supabase.co 或反代 https://<site>/sb
# WB_SUPABASE_URL=

# publishable / anon key（apikey 头）
# WB_SUPABASE_ANON_KEY=

# 公共授权注入的 authenticated JWT；未注入时可用下面两项换一次令牌
# WB_SUPABASE_TOKEN=
# WB_SUPABASE_EMAIL=
# WB_SUPABASE_PASSWORD=

# 仅调试：云端失败时允许回退离线快照。正式运行不要设置
# WB_PRICING_FALLBACK=

# 仅一次性补库：管理员级令牌，执行 cli.py sync-seeds 后立即清除
# WB_SUPABASE_SYNC_TOKEN=

# ============================================================================
# 【可选离线兜底】仅供本机调试 / 断网演练，不随项目 Skill 分发
# ============================================================================
# 解密密钥（32 字节 base64）。若确需本机使用，写入被 .gitignore 忽略的文件并 chmod 600
# BENCHMARK_SNAPSHOT_KEY=

# 指向仓库外的自备密文；不设则用技能目录 data/benchmark_snapshot.enc
# BENCHMARK_SNAPSHOT_PATH=

# 重建快照时指向含 data/seeds/ 的仓库根目录
# DECORATION_PRICING_REPO=
