# ═══════════════════════════════════════════════
# 装修工程AI套价系统 — 环境变量配置模板
# ═══════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ⚠️ .env 包含密钥，绝不要提交到 Git！

# ── 必填 ───────────────────────────────────────

# 应用密钥 (生产环境: openssl rand -hex 32)
SECRET_KEY=change-me-to-random-string

# Supabase 连接
SUPABASE_URL=https://lnvtykghcpsjpwczbqsm.supabase.co
SUPABASE_ANON_KEY=sb_publishable_VQNxLrsKEZuZDeAGa7xOAg__SUeFH_Q
SUPABASE_SERVICE_ROLE_KEY=change-me-to-service-role-key

# 邮件 (Cloudflare Worker)
EMAIL_WORKER_URL=https://email-service.xxx.workers.dev
EMAIL_SERVICE_TOKEN=change-me-to-random-token

# 前端地址
FRONTEND_URL=https://decoration-pricing-system.pages.dev

# CORS 允许的前端域名 (逗号分隔)
# 生产环境: ["https://your-app.pages.dev","https://admin.your-domain.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# ── 可选 ───────────────────────────────────────

# 应用模式: production / development
APP_ENV=production

# DeepSeek API (用户在前端输入 Key，服务端通常无需设置)
# LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com/v1

# 调试开关 (生产环境务必关闭)
DEBUG_PRICING=false

# 计价默认费率
DEFAULT_PROFIT_RATE=7.0
DEFAULT_MANAGEMENT_RATE=5.0
DEFAULT_TAX_RATE=9.0

# 文件上传限制 (字节)
MAX_UPLOAD_SIZE=10485760
